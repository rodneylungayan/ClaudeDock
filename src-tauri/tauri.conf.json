{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClaudeDock",
  "version": "0.1.0",
  "identifier": "local.accountprofilemanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClaudeDock",
        "width": 1000,
        "height": 700,
        "minWidth": 700,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Mactan Digital"
  }
}
